* ============================================================================
* Modelos SPICE del TP2 (Electronica Aplicada II, UTN FRC)
* Compatibles con ngspice y LTspice.
* ============================================================================
*
* ---------------------------------------------------------------------------
* TL084: macromodelo de Texas Instruments (Parts Release 4.01, 16/06/1989).
* GBW = 3 MHz, SR = 13 V/us, entrada JFET.
* Conexiones: 1 = (+), 2 = (-), 3 = V+, 4 = V-, 5 = salida
* ---------------------------------------------------------------------------
.SUBCKT TL084    1   2   3   4   5
  C1    11  12  3.498E-12
  C2     6   7  15.00E-12
  DC     5  53  DX
  DE    54   5  DX
  DLP   90  91  DX
  DLN   92  90  DX
  DP     4   3  DX
  EGND  99   0  POLY(2) (3,0) (4,0) 0 .5 .5
  FB     7  99  POLY(5) VB VC VE VLP VLN 0  4.715E6 -5E6 5E6 5E6 -5E6
  GA     6   0  11  12  282.8E-6
  GCM    0   6  10  99  8.942E-9
  ISS    3  10  DC  195.0E-6
  HLIM  90   0  VLIM 1K
  J1    11   2  10  JX
  J2    12   1  10  JX
  R2     6   9  100.0E3
  RD1    4  11  3.536E3
  RD2    4  12  3.536E3
  RO1    8   5  150
  RO2    7  99  150
  RP     3   4  2.143E3
  RSS   10  99  1.026E6
  VB     9   0  DC  0
  VC     3  53  DC  2.200
  VE    54   4  DC  2.200
  VLIM   7   8  DC  0
  VLP   91   0  DC  25
  VLN    0  92  DC  25
.MODEL DX D(IS=800.0E-18)
.MODEL JX PJF(IS=15.00E-12 BETA=270.1E-6 VTO=-1)
.ENDS TL084
*
* ---------------------------------------------------------------------------
* 1N4004: rectificador de uso general (familia 1N400x, 1 A).
* Parametros de juntura del modelo 1N4007 de Diodes Inc. (misma pastilla en
* toda la familia; solo cambia la tension inversa). TT = 5 us.
* ---------------------------------------------------------------------------
.model D1N4004 D(Is=90p Rs=40m Cjo=30p N=1.4 TT=5u BV=400 IBV=5u)
*
* ---------------------------------------------------------------------------
* 1N4148: diodo de conmutacion rapida (onsemi). TT = 20 ns.
* ---------------------------------------------------------------------------
.model D1N4148 D(Is=2.52n Rs=.568 N=1.752 Cjo=4p M=.4 TT=20n BV=100 IBV=5u)
*
* ---------------------------------------------------------------------------
* Diodo ideal (solo para comparacion): conmuta sin almacenamiento de carga.
* ---------------------------------------------------------------------------
.model DIDEAL D(Is=1e-14 N=0.05 Rs=1m Cjo=0 TT=0)
*
* ---------------------------------------------------------------------------
* 1N750: zener de 4,7 V, 500 mW, DO-35 (modelo onsemi).
* ---------------------------------------------------------------------------
.model D1N750 D(Is=.88f Rs=.25 Cjo=175p M=.55 Nbv=1.7 BV=4.7 Vj=.75 Isr=1.86n Nr=2 Ibv=20.245m Ibvl=1.96m Nbvl=15 Tbv1=-21.3u)
